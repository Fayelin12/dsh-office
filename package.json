{
  "name": "dsh-office",
  "version": "0.3.0",
  "description": "Agent-office dashboard for DeepSeek Harness (DSH): a 6-column sprite office visualizing workspaces, sessions, token usage and subagents — with built-in Agent Mail, Feishu/Lark message feed, meeting schedules, transcripts and an office log tab. One screen to see what every agent is doing, plus your mail, messages & meetings. 给 DeepSeek Harness 的「办公室」插件：工作区/会话/token/子代理/Agent邮箱/飞书消息/会议日程/妙记逐字稿/办公室日志一屏总览，一眼看穿每个 Agent 在忙什么。",
  "license": "MIT",
  "author": "nanfei",
  "keywords": [
    "dsh-plugin",
    "deepseek-harness",
    "dsh",
    "deepseek",
    "plugin",
    "office",
    "workspace",
    "session",
    "dashboard",
    "visualization",
    "subagent",
    "token-usage",
    "agent",
    "productivity",
    "agent-mail",
    "feishu",
    "lark",
    "meeting",
    "calendar",
    "transcript",
    "日志",
    "办公室",
    "工作区",
    "会话",
    "可视化",
    "仪表盘",
    "插件",
    "邮箱",
    "飞书",
    "会议",
    "妙记",
    "逐字稿"
  ],
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": {
      "default": "./lib/index.js"
    },
    "./client": {
      "default": "./lib/client.js"
    },
    "./package.json": "./package.json"
  },
  "homepage": "https://github.com/Fayelin12/dsh-office#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Fayelin12/dsh-office.git"
  },
  "bugs": {
    "url": "https://github.com/Fayelin12/dsh-office/issues"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [],
