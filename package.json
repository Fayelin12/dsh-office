{
  "name": "dsh-office",
  "version": "0.2.0",
  "description": "Agent-office dashboard for DeepSeek Harness (DSH): a 6-column sprite office visualizing workspaces, sessions, token usage and subagents — with a built-in Agent Mail inbox to read, send & reply right in the panel. 给 DeepSeek Harness 的「办公室」插件：工作区/会话/token/子代理一屏总览，内置 Agent 邮箱收发，一眼看穿每个 Agent 在忙什么。",
  "license": "MIT",
  "author": "nanfei",
  "keywords": [
    "dsh-plugin",
    "deepseek-harness",
    "dsh",
    "deepseek",
    "plugin",
    "office",
    "workspace",
    "session",
    "dashboard",
    "visualization",
    "subagent",
    "token-usage",
    "agent",
    "productivity",
    "办公室",
    "工作区",
    "会话",
    "可视化",
    "仪表盘",
    "插件"
  ],
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": {
      "default": "./lib/index.js"
    },
    "./client": {
      "default": "./lib/client.js"
    },
    "./package.json": "./package.json"
  },
  "homepage": "https://github.com/Fayelin12/dsh-office#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Fayelin12/dsh-office.git"
  },
  "bugs": {
    "url": "https://github.com/Fayelin12/dsh-office/issues"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [],
      "platform": "web"
    }
  },
  "files": [
    "lib",
    "assets",
    "scripts",
    "cordis.patch.yml",
    "README.md",
    "llms.txt",
    "LICENSE"
  ],
  "engines": {
    "node": ">=18"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.0"
  }
}
